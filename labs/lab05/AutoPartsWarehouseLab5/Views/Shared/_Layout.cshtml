@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var critical = Context.Request.Query["criticalOnly"] == "true";
}
<!DOCTYPE html>
<html lang="uk">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "Склад запчастин") — Автосклад</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>
    <header class="warehouse-header">
        <nav class="container navbar navbar-expand-md navbar-dark">
            <a class="navbar-brand" asp-controller="AutoParts" asp-action="Index">
                <span class="brand-icon">A</span>
                Автосклад
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navigation"
                    aria-controls="navigation" aria-expanded="false" aria-label="Відкрити меню">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navigation">
                <div class="navbar-nav ms-auto">
                    @if (User.IsInRole(WarehouseRoles.Administrator))
                    { <a class="nav-link" asp-controller="Admin" asp-action="Index">Користувачі</a> }
                    @if (User.IsInRole(WarehouseRoles.Manager) || User.IsInRole(WarehouseRoles.WarehouseWorker))
                    {
                        <a class="nav-link" asp-controller="AutoParts" asp-action="Index">Запчастини</a>
                        <a class="nav-link" asp-controller="AutoParts" asp-action="Index" asp-route-criticalOnly="true">Критичні залишки</a>
                        <a class="nav-link" asp-controller="PurchaseOrders" asp-action="Index">Замовлення</a>
                        <a class="nav-link" asp-controller="VehicleModels" asp-action="Index">Моделі авто</a>
                        <a class="nav-link" asp-controller="AutoParts" asp-action="Issues">Видачі</a>
                    }
                    @if (User.IsInRole(WarehouseRoles.Manager))
                    {
                        <a class="nav-link" asp-controller="AutoParts" asp-action="Notices">Повідомлення</a>
                        <a class="nav-link" asp-controller="Suppliers" asp-action="Index">Постачальники</a>
                        <a class="nav-link" asp-controller="Reports" asp-action="Index">Звіти</a>
                    }
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <form asp-controller="Account" asp-action="Logout" method="post"><button type="submit" class="btn btn-outline-light btn-sm">Вийти (@User.Identity.Name)</button></form>
                    }
                    else { <a class="nav-link" asp-controller="Account" asp-action="Login">Увійти</a> }
                </div>
            </div>
        </nav>
    </header>

    <div class="container workspace">
        <p class="eyebrow">ОБЛІК ЗАПЧАСТИН / СКЛАД</p>
        @if (User.IsInRole(WarehouseRoles.Manager))
        {
            @await Component.InvokeAsync("CriticalStockBanner")
        }
        <main id="main-content">
            @if (TempData["Success"] is string message)
            {
                <div class="alert alert-success" role="alert">@message</div>
            }
            @if (TempData["Error"] is string error)
            {
                <div class="alert alert-danger" role="alert">@error</div>
            }
            @RenderBody()
        </main>
    </div>

    <footer class="container warehouse-footer">
        <span>Автосклад</span>
        <span>Запчастини · Постачання · Видача · Звіти</span>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
