@model AutoPartsWarehouse.Models.AutoPart

<h1>Додати запчастину</h1>

<form asp-action="Create" method="post">

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div>
        <label asp-for="Name">Назва</label>
        <input asp-for="Name" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div>
        <label asp-for="Manufacturer">Виробник</label>
        <input asp-for="Manufacturer" />
        <span asp-validation-for="Manufacturer" class="text-danger"></span>
    </div>

    <div>
        <label asp-for="QuantityInStock">Кількість на складі</label>
        <input asp-for="QuantityInStock" />
        <span asp-validation-for="QuantityInStock" class="text-danger"></span>
    </div>

    <div>
        <label asp-for="MinimumStock">Мінімальний залишок</label>
        <input asp-for="MinimumStock" />
        <span asp-validation-for="MinimumStock" class="text-danger"></span>
    </div>

    <button type="submit">Додати</button>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
