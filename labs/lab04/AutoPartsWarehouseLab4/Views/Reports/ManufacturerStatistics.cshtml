@model List<AutoPartsWarehouse.ViewModels.ManufacturerStockViewModel>

<h1>Статистика за виробниками</h1>

<div class="table-responsive">
<table class="table table-bordered">
    <thead>
        <tr>
            <th>Виробник</th>
            <th>Кількість видів запчастин</th>
            <th>Найменувань із критично малим залишком (більше 0)</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Manufacturer</td>
                <td>@item.PartCount</td>
                <td>@item.CriticalPartCount</td>
            </tr>
        }
    </tbody>
</table>
</div>

<a asp-action="Index" class="btn btn-outline-secondary">Назад до звітів</a>
