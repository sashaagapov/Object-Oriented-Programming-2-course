@model AutoPartsWarehouse.ViewModels.IssuedByPeriodViewModel
<h1>Видачі та повернення за період</h1>
<form method="get" class="mb-3"><label>Від <input type="date" name="from" value="@ViewBag.From" /></label> <label>До <input type="date" name="to" value="@ViewBag.To" /></label> <button>Показати</button></form>
<p>Підсумок враховує дату фактичної видачі та дату повернення окремо. Історичні скасування показані лише в історії.</p>
<table class="table"><thead><tr><th>Запчастина</th><th>Виробник</th><th>Видано за період</th><th>Повернуто за період</th><th>Різниця за період</th></tr></thead><tbody>
@foreach (var row in Model.Summary) { <tr><td>@row.PartName</td><td>@row.Manufacturer</td><td>@row.TotalIssued</td><td>@row.TotalReturned</td><td>@row.Net</td></tr> }
</tbody></table>
<h2>Історія документів за датою створення</h2>
<table class="table"><thead><tr><th>Запчастина</th><th>Кількість</th><th>Створено</th><th>Статус</th></tr></thead><tbody>
@foreach (var issue in Model.Issues) { <tr><td>@issue.AutoPart.Name</td><td>@issue.Quantity</td><td>@issue.CreatedAt.ToLocalTime().ToString("g")</td><td>@issue.StatusLabel</td></tr> }
</tbody></table>
<a asp-action="Index">Назад до звітів</a>
