@model AutoPartsWarehouse.ViewModels.IssuePartViewModel

<h1>Оформити майбутню видачу</h1>

<p><strong>Запчастина:</strong> @Model.PartName</p>
<p><strong>На складі:</strong> @Model.QuantityInStock</p>

<form asp-action="Issue" method="post">

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <input type="hidden" asp-for="AutoPartId" />

    <div>
        <label asp-for="Quantity">Кількість для видачі</label>
        <input asp-for="Quantity" min="1" />
        <span asp-validation-for="Quantity" class="text-danger"></span>
    </div>

    <p class="form-hint">Після оформлення залишок не зміниться. Менеджер підтвердить оплату, а комірник виконає фактичну видачу.</p>
    <button type="submit">Створити документ</button>
</form>

<a asp-action="Index">Назад</a>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
