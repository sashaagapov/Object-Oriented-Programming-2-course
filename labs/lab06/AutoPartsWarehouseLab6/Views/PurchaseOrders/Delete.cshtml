@model AutoPartsWarehouse.Models.PurchaseOrder
<h1>Анулювати замовлення №@Model.Id</h1>
<p>Постачальник: @Model.Supplier.Name. Залишки не зміняться, історію буде збережено.</p>
<form asp-action="Delete" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Анулювати замовлення?')">
    <div asp-validation-summary="All" class="text-danger"></div>
    <label for="reason">Причина анулювання</label><input id="reason" name="reason" required maxlength="500" />
    <button type="submit" class="btn btn-danger">Анулювати замовлення</button>
    <a asp-action="Details" asp-route-id="@Model.Id">Назад</a>
</form>
