@model IEnumerable<AutoPartsWarehouse.Models.VehicleModel>

<h1>Моделі автомобілів</h1>
<p class="subtitle">Керуйте сумісністю моделей автомобілів із запчастинами.</p>
@if (User.IsInRole(WarehouseRoles.Manager))
{ <p><a class="btn btn-primary" asp-action="Create">+ Додати модель</a></p> }

<div class="table-responsive">
    <table class="table">
        <thead><tr><th>Марка</th><th>Модель</th><th>Рік</th><th>Сумісні запчастини</th><th>Дії</th></tr></thead>
        <tbody>
        @foreach (var vehicle in Model)
        {
            <tr>
                <td>@vehicle.Brand</td>
                <td>@vehicle.ModelName</td>
                <td>@vehicle.ProductionYear</td>
                <td>@vehicle.AutoParts.Count</td>
                <td>
                    @if (User.IsInRole(WarehouseRoles.Manager))
                    {
                        <a asp-action="Edit" asp-route-id="@vehicle.Id">Редагувати</a>
                        <a asp-action="Delete" asp-route-id="@vehicle.Id" class="ms-2">Видалити</a>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

@if (!Model.Any()) { <p>Моделей автомобілів поки немає.</p> }
