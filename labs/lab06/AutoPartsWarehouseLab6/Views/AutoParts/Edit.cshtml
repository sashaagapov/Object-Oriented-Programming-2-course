@model AutoPartsWarehouse.Models.AutoPart

<h1>Редагувати запчастину</h1>

<form asp-action="Edit" method="post">

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <input type="hidden" asp-for="Id" />

    <div>
        <label asp-for="Name">Назва</label>
        <input asp-for="Name" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div>
        <label asp-for="Manufacturer">Виробник</label>
        <input asp-for="Manufacturer" />
        <span asp-validation-for="Manufacturer" class="text-danger"></span>
    </div>

    <div>
        <label asp-for="MinimumStock">Мінімальний залишок</label>
        <input asp-for="MinimumStock" />
        <span asp-validation-for="MinimumStock" class="text-danger"></span>
    </div>

    <button type="submit">Зберегти</button>

</form>

<a asp-action="Index">Назад до списку</a>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
